OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=openai/gpt-oss-120b
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=AIOpsAgent
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/operations_agent
MAX_RETRIES=2
# Keep false for normal use; set true only for local deterministic tests/demo mode.
ALLOW_OFFLINE_MODE=false
API_ACCESS_TOKEN=replace_with_a_long_random_admin_token
# Optional JSON map: token -> user ID or {"user_id":"alice","role":"operator"}; use 32+ character tokens.
API_ACCESS_TOKENS=
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
